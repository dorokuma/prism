# Prism config template.
#
# Production (systemd on this host):
#   WorkingDirectory = /var/lib/prism
#   Install:  cp config.yaml.example /var/lib/prism/config.yaml
#             edit /var/lib/prism/config.yaml
#   Binary:   install -m 755 ./prism /usr/local/bin/prism
#   Keys:     systemd LoadCredential (see scripts/prism.service.example)
#             OR env LB_KEY_<NAME>  (hyphens in account name → underscores)
#   Do NOT commit real keys. Source tree must not hold production config.yaml.
#
# Local dev:
#   cp config.yaml.example config.yaml
#   export LB_KEY_ACCOUNT_1=...
#   ./prism

debug: false
listen: "127.0.0.1:18790"

# Optional authentication token for /v1/* endpoints. When set, clients must
# send "Authorization: Bearer <token>". Env var: PRISM_AUTH_TOKEN.
# auth_token: "your-secret-token"

# Optional TLS. When both set, server listens with HTTPS. Env vars: PRISM_TLS_CERT, PRISM_TLS_KEY.
# tls_cert_file: "/path/to/cert.pem"
# tls_key_file: "/path/to/key.pem"

# Optional trusted reverse proxy CIDRs. When set, X-Forwarded-For is only
# trusted for requests coming from these CIDRs (rightmost XFF entry used).
# When empty, only RemoteAddr is used for rate limiting (safest default).
# trusted_proxies:
#   - "10.0.0.0/8"
#   - "127.0.0.0/8"

probe_interval: 10m
probe_model: "deepseek-chat"
# wire_api: legacy | responses | both
wire_api: both

model_tiers:
  frontier: deepseek-v4-pro
  standard: deepseek-v4-flash
  glm-standard: glm-5.2
default_tier: standard

# 按 tier 声明上游不支持、需要在转发前剥离的请求字段。
# 匹配发生在 model remap 之后，按上游真实模型名所属的 tier 命中。
# 新增 GLM/z-ai 系上游时记得同步加条目，否则可能 400。
strip_fields:
  glm-standard:
    - prompt_cache_retention

model_remap:
  gpt-5.5: frontier
  gpt-5.5-pro: frontier
  gpt-5.4: standard
  gpt-5.4-mini: standard
  gpt-5.3-codex: standard
  glm-5.2: glm-standard

accounts:
  # name "account-1" → credential/env LB_KEY_ACCOUNT_1
  - name: account-1
    # key: "sk-..."   # optional; omit in production and use LoadCredential/env
    base_url: https://opencode.ai/zen/go/v1
  - name: account-2
    base_url: https://opencode.ai/zen/go/v1

# ---------------------------------------------------------------------------
# 可选：default_provider —— 请求未带 X-Prism-Provider 头时的兜底 provider。
# 不配（默认）= 拒绝无头请求：直接返回 HTTP 400
#   {"error":{"message":"missing X-Prism-Provider header","type":"invalid_request_error"}}
# 不会回退到全池选择（回退会让任意账号被命中，导致账号跨 provider 串用）。
# 配置后：无头请求按该 provider 走正常的 per-provider 轮转。
# 值必须是下方 providers（或 accounts 的 provider 字段）中已存在的 provider 名，
# 否则启动报错退出。
# ---------------------------------------------------------------------------
# default_provider: "agentrouter-anthropic"

# ---------------------------------------------------------------------------
# 可选：max_concurrent_per_account —— 按模型名精确匹配的单账号最大并发。
# 未命中的模型回退到代码内置默认值（含 flash/pro 关键字推断），并打
# "unknown model, using default concurrency" 告警；显式列出即可消除告警。
# 值含义：agentrouter（第三方中转网关）账号取保守值 8；opencode-go 侧模型
# 与 deepseek-v4-pro 同量级取 450。
# ---------------------------------------------------------------------------
# max_concurrent_per_account:
#   claude-opus-5: 8
#   claude-opus-4-8: 8
#   gpt-5.6-sol: 8
#   mimo-v2.5: 450
#   grok-4.5: 450

# Optional: tool definitions cache for request injection (Codex-related).
# Production path matches service data dir:
mcp_tools_json: "/var/lib/prism/mcp_tools.json"

# ---------------------------------------------------------------------------
# agentrouter 账号池示例（可选接入；默认全部注释，不影响现有账号）
#
# 4 个账号 = 2 把 key × 两协议（openai / anthropic）。key 一律省略，走凭证：
#   LB_KEY_AGENTROUTER_OAI_1 / LB_KEY_AGENTROUTER_OAI_2 /
#   LB_KEY_AGENTROUTER_ANT_1 / LB_KEY_AGENTROUTER_ANT_2
# （账号名连字符转下划线后大写，规则同 account-1 → LB_KEY_ACCOUNT_1）
#
# probe_path: disabled —— 探活端点（GET /v1/models）未实测，disabled 表示
# 不发探活请求；exhausted 账号会在每个 probe_interval 周期被乐观置回
# healthy。若确认 GET /v1/models 可用，把该行改成 probe_path: /v1/models
# 或删掉即可，不需要改代码。
#
# auth_header（可选，账号级）：默认写 Authorization: Bearer <key>；若上游
# 只认 x-api-key 之类的自定义头，设为该头名即可（值写裸 key，不再写
# Authorization 头）。
#
# skip_pi_sync: true —— agentrouter 的 pi models.json 元数据（例如
# api: anthropic-messages 与模型 contextWindow 等）由人工维护，prism 不
# 覆盖该 provider 条目（模型拉取不受影响）。
#
# 上游专用请求头（User-Agent、anthropic-beta、x-app 等）由 prism 在转发
# 时按账号注入，pi 侧只需带 X-Prism-Provider 头即可。
# ---------------------------------------------------------------------------
# providers:
#   agentrouter-openai:
#     accounts:
#       - name: agentrouter-oai-1
#         base_url: https://your-gateway.example.com/v1
#         skip_pi_sync: true
#         probe_path: disabled
#         # auth_header: x-api-key
#         headers:
#           Originator: codex_cli_rs
#           User-Agent: codex-cli/1.0.0
#           x-app: cli
#       - name: agentrouter-oai-2
#         base_url: https://your-gateway.example.com/v1
#         skip_pi_sync: true
#         probe_path: disabled
#         headers:
#           Originator: codex_cli_rs
#           User-Agent: codex-cli/1.0.0
#           x-app: cli
#   agentrouter-anthropic:
#     accounts:
#       - name: agentrouter-ant-1
#         base_url: https://your-gateway.example.com/
#         skip_pi_sync: true
#         probe_path: disabled
#         headers:
#           User-Agent: "claude-cli/1.0.0 (external, cli)"
#           anthropic-beta: "claude-code-20250219,interleaved-thinking-20250219"
#           anthropic-dangerous-direct-browser-access: "true"
#           x-app: cli
#       - name: agentrouter-ant-2
#         base_url: https://your-gateway.example.com/
#         skip_pi_sync: true
#         probe_path: disabled
#         headers:
#           User-Agent: "claude-cli/1.0.0 (external, cli)"
#           anthropic-beta: "claude-code-20250219,interleaved-thinking-20250219"
#           anthropic-dangerous-direct-browser-access: "true"
#           x-app: cli
