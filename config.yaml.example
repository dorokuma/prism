# Prism config template.
#
# Production (systemd on this host):
#   WorkingDirectory = /var/lib/prism
#   Install:  cp config.yaml.example /var/lib/prism/config.yaml
#             edit /var/lib/prism/config.yaml
#   Binary:   install -m 755 ./prism /usr/local/bin/prism
#   Keys:     systemd LoadCredential (see scripts/prism.service.example)
#             OR env LB_KEY_<NAME>  (hyphens in account name → underscores)
#   Do NOT commit real keys. Source tree must not hold production config.yaml.
#
# Local dev:
#   cp config.yaml.example config.yaml
#   export LB_KEY_ACCOUNT_1=...
#   ./prism

debug: false
listen: "127.0.0.1:18790"

# Optional authentication for /v1/* endpoints (excluding /health). Two forms,
# both supported; clients send "Authorization: Bearer <token>".
#
# 1) Legacy single token (still fully supported). Env var: PRISM_AUTH_TOKEN.
#    auth_token: "your-secret-token"
#
# 2) Multiple named keys (new):
#    api_keys:
#      - name: ci-bot
#        token: "sk-ci-..."
#      - name: human
#        token: "sk-human-..."
#    The key NAME (never the token) is recorded in audit logs as key_id.
#
# Merge rules when both are configured:
#   - api_keys empty + auth_token set → a single key {name: default, token: <auth_token>}.
#   - both set → auth_token is appended as {name: default, token: <auth_token>}
#     UNLESS its value already equals an api_keys token (then that api_keys
#     entry's name wins and no extra default entry is injected).
#   - neither set + non-loopback listen → startup error (loopback allows no auth).
# auth_token: "your-secret-token"
# api_keys:
#   - name: default
#     token: "your-secret-token"

# Optional TLS. When BOTH are set (or both come from the PRISM_TLS_CERT /
# PRISM_TLS_KEY env vars), the server listens with HTTPS. A non-loopback
# listen address REQUIRES a complete TLS configuration: loading fails
# otherwise, and configuring exactly one of the two files is always a load
# error (the server would silently serve plaintext). trusted_proxies does
# NOT relax this — it only controls X-Forwarded-For trust and cannot prevent
# direct access to the listener. To explicitly serve plaintext on a
# non-loopback address (e.g. an internal network or a TLS-terminating
# reverse proxy you fully control), set allow_insecure_http: true — the
# traffic is then unencrypted and any network observer can read the client
# credentials. Loopback listeners (127.0.0.1 / ::1) never need TLS (local
# development).
# SIGHUP cannot hot-apply TLS files: a change is warned and the running
# cert/key paths stay in the holder so published tool URLs keep the scheme
# of the live listener. Restart to pick up new files.
# tls_cert_file: "/path/to/cert.pem"
# tls_key_file: "/path/to/key.pem"
# allow_insecure_http: false

# Optional trusted reverse proxy CIDRs. When set, X-Forwarded-For is only
# trusted for requests coming from these CIDRs. The XFF chain is walked
# right-to-left skipping every trusted hop; the first untrusted valid IP is
# the client (multi-hop chains resolve correctly). X-Real-IP is accepted
# ONLY when XFF is absent AND the value is a valid IP outside the trusted
# CIDRs; an all-trusted XFF or a trusted/invalid X-Real-IP falls back to
# RemoteAddr. When empty, only RemoteAddr is used for rate limiting
# (safest default).
# Authenticated requests (api_keys configured and a matching Bearer) are
# rate-limited per key name (`key:<name>`), not per client IP, so a local
# reverse proxy that presents 127.0.0.1 does not put every client in one
# bucket. Failed or missing tokens still use the IP bucket.
#
# Whole-address-space ranges are REJECTED at load: 0.0.0.0/0 and ::/0 would
# make every address "trusted", so the XFF chain walk finds no untrusted
# client hop and client-IP resolution collapses to RemoteAddr — per-client
# rate limiting silently degrades to keying on the proxy's address for all
# proxied traffic (X-Real-IP never rescues it: it is only accepted when
# UNtrusted). Always configure the actual proxy network.
# trusted_proxies:
#   - "10.0.0.0/8"
#   - "127.0.0.0/8"

probe_interval: 10m
# wire_api: legacy | responses | both
wire_api: both

# 可选：非流式上游响应体大小上限（字节）。默认 32 MiB（33554432）。
# 超过上限的上游响应（chat 透传与 responses 翻译两条路径）以
# HTTP 502 + code=response_too_large 拒绝，避免整包缓冲进内存。
# 配 0 或不配 = 默认值；负数或超过 256 MiB（268435456，硬上限）启动报错。
# 热更生效。
# max_upstream_response_bytes: 33554432

model_tiers:
  frontier: deepseek-v4-pro
  standard: deepseek-v4-flash
  glm-standard: glm-5.2
default_tier: standard

# 按 tier 声明上游不支持、需要在转发前剥离的请求字段。
# 匹配发生在 model remap 之后，按上游真实模型名所属的 tier 命中。
# 新增 GLM/z-ai 系上游时记得同步加条目，否则可能 400。
strip_fields:
  glm-standard:
    - prompt_cache_retention

model_remap:
  gpt-5.5: frontier
  gpt-5.5-pro: frontier
  gpt-5.4: standard
  gpt-5.4-mini: standard
  gpt-5.3-codex: standard
  glm-5.2: glm-standard

# ---------------------------------------------------------------------------
# 可选：model_metadata —— /v1/models 返回的按模型元数据（context_window /
# max_tokens / reasoning / input / cost / thinking_level_map / extra）。
# cost 字段单位：USD per 1M tokens（每百万 token 的美元价）。
# 例如 input: 0.6 表示每百万输入 token 0.6 美元。依据：生产配置实际数值量级
# 0.14 ~ 4.4，且 internal/proxy/models.go 与 internal/cache/models.go 全程
# 纯透传无换算，单位即上游原始单位。
# ---------------------------------------------------------------------------
# model_metadata:
#   deepseek-v4-pro:
#     context_window: 1000000
#     cost:
#       input: 0.6
#       output: 2.4
#       cache_read: 0.12
#       cache_write: 0.6

# ---------------------------------------------------------------------------
# 可选：usage —— 每次请求的词元用量与费用落 SQLite，供
# GET /admin/usage/summary 聚合查询。默认关闭（enabled: false，opt-in：
# 不配 usage 段时现有部署行为完全不变）。
#
#   启用后降级保证：usage 的任何故障（库打不开、磁盘满、SQLITE_BUSY、
#   队列满、计价异常）一律只打日志加计数器（expvar usage_write_errors /
#   usage_events_dropped / usage_events_written / usage_recorder_status），
#   绝不影响 /v1 代理转发，绝不 panic，绝不阻塞请求收尾。丢失事件的日志
#   限频（默认 5 秒内同类别最多一条），计数不受限频影响。
#
#   ⚠ 计费口径：usage 记录是尽力而为（best-effort），不是严格计费源。
#   队列满 / 进程关闭 / 存储故障时事件会被丢弃（dropped 计数 + 限频日志
#   可查），对账请以 request.complete 审计日志为准。
#
#   enabled:        总开关。默认 false。
#   db_path:        SQLite 文件路径。默认 /var/lib/prism/usage.db（与模型
#                   缓存目录 /var/lib/prism/model_cache 同级）。
#                   ⚠ 不可热更：修改后必须重启进程才生效（SIGHUP 热重载
#                   会打 restart required 告警，实际仍用旧库）。
#   retention_days: 事件保留天数，超期的定期清理删除。默认 30；显式配 0
#                    = 永久保留，关闭清理（注意：不配才是 30，配 0 不是）。
#   channel_size:   内存事件队列容量。默认 4096；队列满时丢事件并计数，
#                   绝不阻塞请求。
#   batch_size:     单 worker 攒批写入条数。默认 50。
#   batch_flush_ms: 批刷新间隔毫秒。默认 200。
#   default_key_id: 未携带已认证 api key 的请求（鉴权关闭、或早期拒绝路径）
#                   落库的 key_id。默认 anonymous——网关不知道客户端叫什么，
#                   需要按客户端归一时显式配置（显式配空串 = 用默认值）。
#                   配了 api_keys 且请求带正确 key 时仍记 key 的 name。
#
#   计价：成本单价取 model_metadata[].cost（USD per 1M tokens，见上），
#   按请求当时的配置（provider + model）解析；查不到单价的模型成本记为
#   NULL / cost_status=missing_price，词元照常入库。
#   口径：OpenAI 口径的 prompt_tokens 包含缓存部分（cached 按 cache_read
#   单价另计）；Anthropic 口径的 input_tokens 不含缓存（cache_read /
#   cache_creation 平级另算，input 全额计价）。未配 cache_read（YAML 缺省
#   为 0）按 input 单价计缓存，不当免费；要打折必须显式写正数 cache_read。
#   每行落库 usage_source（openai / anthropic）便于核对计价依据。
#
#   查询接口：GET /admin/usage/summary
#     - 鉴权（fail-closed）：配置了环境变量 PRISM_ADMIN_TOKEN 时，所有请求
#       （含本机 loopback）都必须带 Authorization: Bearer <token>（常量时间
#       比较）；仅当未配置 token 时，本机 loopback 且无 X-Forwarded-For/
#       X-Real-IP/Forwarded 的直接请求才免鉴权（与 /metrics 一致）。token
#       每次请求都从环境变量重新读取，轮换后无需重启即生效。
#     - 不走业务 api_keys 鉴权，挂载在全局鉴权之前。
#     - 支持参数：from/to（unix 秒）、group_by（model/provider/account/
#       key_id/stream/success/hour/day）、model/provider/account/key_id/
#       stream/success 过滤、limit（默认 100，上限 1000）。
#     - usage 未启用或库打开失败时返回 503 store_unavailable。
# ---------------------------------------------------------------------------
# usage:
#   enabled: true
#   db_path: "/var/lib/prism/usage.db"
#   retention_days: 30
#   channel_size: 4096
#   batch_size: 50
#   batch_flush_ms: 200
#   default_key_id: anonymous

# ---------------------------------------------------------------------------
# 可选：quota —— 上游套餐用量快照（当前：OpenCode Go 的短期 / 中期 / 长期窗口）。
# 和上面的 usage 不是一层：usage 是本地词元账本，quota 是官方限额百分比。
# 关掉 usage.enabled 不影响 quota。
#
#   enabled:           缺省 true。显式 false 关闭 poller，GET /admin/quota 返回 503。
#   refresh_interval:  后台刷新间隔，默认 120s，下限 30s。
#   request_timeout:   单次上游超时，默认 5s。
#
#   查询：prism quota    或    GET /admin/quota
#   鉴权与 /admin/usage/summary 相同（PRISM_ADMIN_TOKEN）。
#   响应里的 ~usd 是按文档额度（$12 / $30 / $60）用整数 percent 估算，不是账单。
# ---------------------------------------------------------------------------
# quota:
#   enabled: true
#   refresh_interval: 120s
#   request_timeout: 5s

accounts:
  # name 规则（LoadConfig 强制，setup 交互同规则）：非空、唯一、以 ASCII
  # 字母/数字开头，仅允许 A-Z a-z 0-9 _ -，最长 64 字节（名称用于
  # LB_KEY_* 凭据/环境变量名、expvar 键、日志与 usage 标签；点、路径分隔符、
  # 空格等均被拒绝）。两个名称折叠到同一个 LB_KEY_*（如 a-b 与 a_b）会
  # 在加载时报错。
  # name "account-1" → credential/env LB_KEY_ACCOUNT_1
  # provider 必填（v0.17.0 起）：provider 为空的账号永远选不到（业务请求按
  # provider 路由），加载会直接报错。裸顶层 accounts 必须声明 provider，
  # 或改用下方 providers 块。
  - name: account-1
    # key: "sk-..."   # optional; omit in production and use LoadCredential/env
    base_url: https://opencode.ai/zen/go/v1
    provider: opencode-go
  - name: account-2
    base_url: https://opencode.ai/zen/go/v1
    provider: opencode-go

# ---------------------------------------------------------------------------
# 可选：default_provider —— 请求未带 X-Prism-Provider 头时的兜底 provider。
# 不配（默认）= 聊天/补全拒绝无头请求：直接返回 HTTP 400
#   {"error":{"message":"missing X-Prism-Provider header","type":"invalid_request_error"}}
# GET /v1/models 在同样情况下返回空列表（不泄漏全部 provider 的目录）。
# 不会回退到全池选择（回退会让任意账号被命中，导致账号跨 provider 串用）。
# 配置后：无头聊天按该 provider 走正常的 per-provider 轮转；/v1/models 也返回该 provider 的目录。
# 值必须是下方 providers（或 accounts 的 provider 字段）中已存在的 provider 名，
# 否则启动报错退出。
# ---------------------------------------------------------------------------
# default_provider: "agentrouter-anthropic"

# ---------------------------------------------------------------------------
# 可选：max_concurrent_per_account —— 按模型名精确匹配的单账号最大并发。
# 未命中的模型回退到内置保守默认值 8（不再按模型名猜 flash/pro 档位；
# 对任何上游都安全，包括低速率限制的个人 key）。想提高并发必须显式配置：
# 显式列出目标模型即可消除 "unknown model, using default concurrency"
# 告警。
#
# 并发上限按“模型名”分组（v0.17.0 起）：每个模型（客户端请求里的
# model 字段，即 max_concurrent_per_account 的键）在账号上拥有独立的
# 在途计数，两个模型即使配置了相同的 max 值也互不挤占（max=2 的模型
# 不会被另一个 max=2 模型的流量饿死）；低上限模型也不会被高上限流量
# 饿死（max=1 的模型在 max=10 的模型占满 10 个并发时仍能拿到自己的
# 1 个并发）。账号总在途 = 各模型之和（/metrics 可查），并受
# max_concurrent_per_account_total 约束。
#
# max_concurrent_per_account_total: 账号级总并发上限（对每个账号生效）。
# 缺省/0 时取向后兼容默认值 = max_concurrent_per_account 中互不相同的
# 正值之和（等价于旧版按 max 值分组的账号总并发上限，配置不变则总并发
# 不变）；显式配置后 N 个模型档位不会让账号总并发线性叠加。
# 负值或大于 2^31-1 报错；改动需重启生效（ReloadConfig 会警告）。
# ---------------------------------------------------------------------------
# max_concurrent_per_account:
#   claude-opus-5: 8
#   claude-opus-4-8: 8
#   gpt-5.6-sol: 8
#   mimo-v2.5: 450
#   grok-4.5: 450

# Optional: tool definitions cache for request injection (Codex-related).
# Production path matches service data dir:
mcp_tools_json: "/var/lib/prism/mcp_tools.json"

# ---------------------------------------------------------------------------
# agentrouter 账号池示例（可选接入；默认全部注释，不影响现有账号）
#
# 4 个账号 = 2 把 key × 两协议（openai / anthropic）。key 一律省略，走凭证：
#   LB_KEY_AGENTROUTER_OAI_1 / LB_KEY_AGENTROUTER_OAI_2 /
#   LB_KEY_AGENTROUTER_ANT_1 / LB_KEY_AGENTROUTER_ANT_2
# （账号名连字符转下划线后大写，规则同 account-1 → LB_KEY_ACCOUNT_1）
#
# probe_path: disabled —— 探活端点（GET /v1/models）未实测，disabled 表示
# 不发探活请求，也不改变账号状态：exhausted 账号保持 exhausted，直到运营者
# 手动恢复或重新启用探活（“不探测”不等于“凭据已恢复”）。若确认 GET
# /v1/models 可用，把该行改成 probe_path: /v1/models 或删掉即可，不需要改代码。
#
# auth_header（可选，账号级）：默认写 Authorization: Bearer <key>；若上游
# 只认 x-api-key 之类的自定义头，设为该头名即可（值写裸 key，不再写
# Authorization 头）。
#
# skip_pi_sync: true —— agentrouter 的 pi models.json 元数据（例如
# api: anthropic-messages 与模型 contextWindow 等）由人工维护，prism 不
# 覆盖该 provider 条目（模型拉取不受影响）。
#
# 上游专用请求头（User-Agent、anthropic-beta、x-app 等）由 prism 在转发
# 时按账号注入，pi 侧只需带 X-Prism-Provider 头即可。
# ---------------------------------------------------------------------------
# providers.<name>.dsml_guard: optional, default false. When true, the legacy
# /v1/chat/completions path (stream and non-stream) strips aborted DSML leaks
# in content and recovers complete DSML tool_calls. The Responses translation
# path is not wired.
# ---------------------------------------------------------------------------
# providers:
#   agentrouter-openai:
#     accounts:
#       - name: agentrouter-oai-1
#         base_url: https://your-gateway.example.com/v1
#         skip_pi_sync: true
#         probe_path: disabled
#         # auth_header: x-api-key
#         headers:
#           Originator: codex_cli_rs
#           User-Agent: codex-cli/1.0.0
#           x-app: cli
#       - name: agentrouter-oai-2
#         base_url: https://your-gateway.example.com/v1
#         skip_pi_sync: true
#         probe_path: disabled
#         headers:
#           Originator: codex_cli_rs
#           User-Agent: codex-cli/1.0.0
#           x-app: cli
#   agentrouter-anthropic:
#     accounts:
#       - name: agentrouter-ant-1
#         base_url: https://your-gateway.example.com/
#         skip_pi_sync: true
#         probe_path: disabled
#         headers:
#           User-Agent: "claude-cli/1.0.0 (external, cli)"
#           anthropic-beta: "claude-code-20250219,interleaved-thinking-20250219"
#           anthropic-dangerous-direct-browser-access: "true"
#           x-app: cli
#       - name: agentrouter-ant-2
#         base_url: https://your-gateway.example.com/
#         skip_pi_sync: true
#         probe_path: disabled
#         headers:
#           User-Agent: "claude-cli/1.0.0 (external, cli)"
#           anthropic-beta: "claude-code-20250219,interleaved-thinking-20250219"
#           anthropic-dangerous-direct-browser-access: "true"
#           x-app: cli
