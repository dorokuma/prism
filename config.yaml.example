# Prism config template.
#
# Production (systemd on this host):
#   WorkingDirectory = /var/lib/prism
#   Install:  cp config.yaml.example /var/lib/prism/config.yaml
#             edit /var/lib/prism/config.yaml
#   Binary:   install -m 755 ./prism /usr/local/bin/prism
#   Keys:     systemd LoadCredential (see scripts/prism.service.example)
#             OR env LB_KEY_<NAME>  (hyphens in account name → underscores)
#   Do NOT commit real keys. Source tree must not hold production config.yaml.
#
# Local dev:
#   cp config.yaml.example config.yaml
#   export LB_KEY_ACCOUNT_1=...
#   ./prism

debug: false
listen: "127.0.0.1:18790"

# Optional authentication for /v1/* endpoints (excluding /health). Two forms,
# both supported; clients send "Authorization: Bearer <token>".
#
# 1) Legacy single token (still fully supported). Env var: PRISM_AUTH_TOKEN.
#    auth_token: "your-secret-token"
#
# 2) Multiple named keys (new):
#    api_keys:
#      - name: ci-bot
#        token: "sk-ci-..."
#      - name: human
#        token: "sk-human-..."
#    The key NAME (never the token) is recorded in audit logs as key_id.
#
# Merge rules when both are configured:
#   - api_keys empty + auth_token set → a single key {name: default, token: <auth_token>}.
#   - both set → auth_token is appended as {name: default, token: <auth_token>}
#     UNLESS its value already equals an api_keys token (then that api_keys
#     entry's name wins and no extra default entry is injected).
#   - neither set + non-loopback listen → startup error (loopback allows no auth).
# auth_token: "your-secret-token"
# api_keys:
#   - name: default
#     token: "your-secret-token"

# Optional TLS. When both set, server listens with HTTPS. Env vars: PRISM_TLS_CERT, PRISM_TLS_KEY.
# tls_cert_file: "/path/to/cert.pem"
# tls_key_file: "/path/to/key.pem"

# Optional trusted reverse proxy CIDRs. When set, X-Forwarded-For is only
# trusted for requests coming from these CIDRs. The XFF chain is walked
# right-to-left skipping every trusted hop; the first untrusted valid IP is
# the client (multi-hop chains resolve correctly). When empty, only
# RemoteAddr is used for rate limiting (safest default).
# trusted_proxies:
#   - "10.0.0.0/8"
#   - "127.0.0.0/8"

probe_interval: 10m
probe_model: "deepseek-chat"
# wire_api: legacy | responses | both
wire_api: both

# 可选：非流式上游响应体大小上限（字节）。默认 32 MiB（33554432）。
# 超过上限的上游响应（chat 透传与 responses 翻译两条路径）以
# HTTP 502 + code=response_too_large 拒绝，避免整包缓冲进内存。
# 配 0 或不配 = 默认值；负数或超过 256 MiB（268435456，硬上限）启动报错。
# 热更生效。
# max_upstream_response_bytes: 33554432

model_tiers:
  frontier: deepseek-v4-pro
  standard: deepseek-v4-flash
  glm-standard: glm-5.2
default_tier: standard

# 按 tier 声明上游不支持、需要在转发前剥离的请求字段。
# 匹配发生在 model remap 之后，按上游真实模型名所属的 tier 命中。
# 新增 GLM/z-ai 系上游时记得同步加条目，否则可能 400。
strip_fields:
  glm-standard:
    - prompt_cache_retention

model_remap:
  gpt-5.5: frontier
  gpt-5.5-pro: frontier
  gpt-5.4: standard
  gpt-5.4-mini: standard
  gpt-5.3-codex: standard
  glm-5.2: glm-standard

# ---------------------------------------------------------------------------
# 可选：model_metadata —— /v1/models 返回的按模型元数据（context_window /
# max_tokens / reasoning / input / cost / thinking_level_map / extra）。
# cost 字段单位：USD per 1M tokens（每百万 token 的美元价）。
# 例如 input: 0.6 表示每百万输入 token 0.6 美元。依据：生产配置实际数值量级
# 0.14 ~ 4.4，且 internal/proxy/models.go 与 internal/cache/models.go 全程
# 纯透传无换算，单位即上游原始单位。
# ---------------------------------------------------------------------------
# model_metadata:
#   deepseek-v4-pro:
#     context_window: 1000000
#     cost:
#       input: 0.6
#       output: 2.4
#       cache_read: 0.12
#       cache_write: 0.6

# ---------------------------------------------------------------------------
# 可选：usage —— 每次请求的 token 用量与费用落 SQLite，供
# GET /admin/usage/summary 聚合查询。默认关闭（enabled: false，opt-in：
# 不配 usage 段时现有部署行为完全不变）。
#
#   启用后降级保证：usage 的任何故障（库打不开、磁盘满、SQLITE_BUSY、
#   队列满、计价异常）一律只打日志加计数器（expvar usage_write_errors /
#   usage_events_dropped / usage_events_written），绝不影响 /v1 代理转发，
#   绝不 panic，绝不阻塞请求收尾。
#
#   enabled:        总开关。默认 false。
#   db_path:        SQLite 文件路径。默认 /var/lib/prism/usage.db（与模型
#                   缓存目录 /var/lib/prism/model_cache 同级）。
#                   ⚠ 不可热更：修改后必须重启进程才生效（SIGHUP 热重载
#                   会打 restart required 告警，实际仍用旧库）。
#   retention_days: 事件保留天数，超期的定期清理删除。默认 30；显式配 0
#                    = 永久保留，关闭清理（注意：不配才是 30，配 0 不是）。
#   channel_size:   内存事件队列容量。默认 4096；队列满时丢事件并计数，
#                   绝不阻塞请求。
#   batch_size:     单 worker 攒批写入条数。默认 50。
#   batch_flush_ms: 批刷新间隔毫秒。默认 200。
#   default_key_id: 未携带已认证 api key 的请求（鉴权关闭、或早期拒绝路径）
#                   落库的 key_id。默认 anonymous——网关不知道客户端叫什么，
#                   需要按客户端归一时显式配置（显式配空串 = 用默认值）。
#                   配了 api_keys 且请求带正确 key 时仍记 key 的 name。
#
#   计价：成本单价取 model_metadata[].cost（USD per 1M tokens，见上），
#   按请求当时的配置（provider + model）解析；查不到单价的模型成本记为
#   NULL / cost_status=missing_price，token 照常入库。
#   口径：OpenAI 口径的 prompt_tokens 包含缓存部分（cached 按 cache_read
#   单价另计）；Anthropic 口径的 input_tokens 不含缓存（cache_read /
#   cache_creation 平级另算，input 全额计价）。每行落库 usage_source
#   （openai / anthropic）便于核对计价依据。
#
#   查询接口：GET /admin/usage/summary
#     - 鉴权（fail-closed）：配置了环境变量 PRISM_ADMIN_TOKEN 时，所有请求
#       （含本机 loopback）都必须带 Authorization: Bearer <token>（常量时间
#       比较）；仅当未配置 token 时，本机 loopback 且无 X-Forwarded-For/
#       X-Real-IP 的直接请求才免鉴权（与 /metrics 一致）。
#     - 不走业务 api_keys 鉴权，挂载在全局鉴权之前。
#     - 支持参数：from/to（unix 秒）、group_by（model/provider/account/
#       key_id/stream/success/hour/day）、model/provider/account/key_id/
#       stream/success 过滤、limit（默认 100，上限 1000）。
#     - usage 未启用或库打开失败时返回 503 store_unavailable。
# ---------------------------------------------------------------------------
# usage:
#   enabled: true
#   db_path: "/var/lib/prism/usage.db"
#   retention_days: 30
#   channel_size: 4096
#   batch_size: 50
#   batch_flush_ms: 200
#   default_key_id: anonymous

accounts:
  # name "account-1" → credential/env LB_KEY_ACCOUNT_1
  - name: account-1
    # key: "sk-..."   # optional; omit in production and use LoadCredential/env
    base_url: https://opencode.ai/zen/go/v1
  - name: account-2
    base_url: https://opencode.ai/zen/go/v1

# ---------------------------------------------------------------------------
# 可选：default_provider —— 请求未带 X-Prism-Provider 头时的兜底 provider。
# 不配（默认）= 拒绝无头请求：直接返回 HTTP 400
#   {"error":{"message":"missing X-Prism-Provider header","type":"invalid_request_error"}}
# 不会回退到全池选择（回退会让任意账号被命中，导致账号跨 provider 串用）。
# 配置后：无头请求按该 provider 走正常的 per-provider 轮转。
# 值必须是下方 providers（或 accounts 的 provider 字段）中已存在的 provider 名，
# 否则启动报错退出。
# ---------------------------------------------------------------------------
# default_provider: "agentrouter-anthropic"

# ---------------------------------------------------------------------------
# 可选：max_concurrent_per_account —— 按模型名精确匹配的单账号最大并发。
# 未命中的模型回退到代码内置默认值（含 flash/pro 关键字推断），并打
# "unknown model, using default concurrency" 告警；显式列出即可消除告警。
# 值含义：agentrouter（第三方中转网关）账号取保守值 8；opencode-go 侧模型
# 与 deepseek-v4-pro 同量级取 450。
# ---------------------------------------------------------------------------
# max_concurrent_per_account:
#   claude-opus-5: 8
#   claude-opus-4-8: 8
#   gpt-5.6-sol: 8
#   mimo-v2.5: 450
#   grok-4.5: 450

# Optional: tool definitions cache for request injection (Codex-related).
# Production path matches service data dir:
mcp_tools_json: "/var/lib/prism/mcp_tools.json"

# ---------------------------------------------------------------------------
# agentrouter 账号池示例（可选接入；默认全部注释，不影响现有账号）
#
# 4 个账号 = 2 把 key × 两协议（openai / anthropic）。key 一律省略，走凭证：
#   LB_KEY_AGENTROUTER_OAI_1 / LB_KEY_AGENTROUTER_OAI_2 /
#   LB_KEY_AGENTROUTER_ANT_1 / LB_KEY_AGENTROUTER_ANT_2
# （账号名连字符转下划线后大写，规则同 account-1 → LB_KEY_ACCOUNT_1）
#
# probe_path: disabled —— 探活端点（GET /v1/models）未实测，disabled 表示
# 不发探活请求；exhausted 账号会在每个 probe_interval 周期被乐观置回
# healthy。若确认 GET /v1/models 可用，把该行改成 probe_path: /v1/models
# 或删掉即可，不需要改代码。
#
# auth_header（可选，账号级）：默认写 Authorization: Bearer <key>；若上游
# 只认 x-api-key 之类的自定义头，设为该头名即可（值写裸 key，不再写
# Authorization 头）。
#
# skip_pi_sync: true —— agentrouter 的 pi models.json 元数据（例如
# api: anthropic-messages 与模型 contextWindow 等）由人工维护，prism 不
# 覆盖该 provider 条目（模型拉取不受影响）。
#
# 上游专用请求头（User-Agent、anthropic-beta、x-app 等）由 prism 在转发
# 时按账号注入，pi 侧只需带 X-Prism-Provider 头即可。
# ---------------------------------------------------------------------------
# providers:
#   agentrouter-openai:
#     accounts:
#       - name: agentrouter-oai-1
#         base_url: https://your-gateway.example.com/v1
#         skip_pi_sync: true
#         probe_path: disabled
#         # auth_header: x-api-key
#         headers:
#           Originator: codex_cli_rs
#           User-Agent: codex-cli/1.0.0
#           x-app: cli
#       - name: agentrouter-oai-2
#         base_url: https://your-gateway.example.com/v1
#         skip_pi_sync: true
#         probe_path: disabled
#         headers:
#           Originator: codex_cli_rs
#           User-Agent: codex-cli/1.0.0
#           x-app: cli
#   agentrouter-anthropic:
#     accounts:
#       - name: agentrouter-ant-1
#         base_url: https://your-gateway.example.com/
#         skip_pi_sync: true
#         probe_path: disabled
#         headers:
#           User-Agent: "claude-cli/1.0.0 (external, cli)"
#           anthropic-beta: "claude-code-20250219,interleaved-thinking-20250219"
#           anthropic-dangerous-direct-browser-access: "true"
#           x-app: cli
#       - name: agentrouter-ant-2
#         base_url: https://your-gateway.example.com/
#         skip_pi_sync: true
#         probe_path: disabled
#         headers:
#           User-Agent: "claude-cli/1.0.0 (external, cli)"
#           anthropic-beta: "claude-code-20250219,interleaved-thinking-20250219"
#           anthropic-dangerous-direct-browser-access: "true"
#           x-app: cli
